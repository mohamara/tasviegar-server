# SMS Service Configuration
# برای فعال‌سازی SMS واقعی، این مقادیر را پر کنید

# انتخاب سرویس SMS
SMS_PROVIDER=console
# SMS_PROVIDER=farapayamak
# SMS_PROVIDER=ippanel

# کلید API سرویس SMS
SMS_API_KEY=your_api_key_here

# آدرس API سرویس SMS
SMS_API_URL=https://api.farapayamak.com
# SMS_API_URL=https://ippanel.com/api

# تنظیمات اضافی
SMS_FROM_NUMBER=Tasviegar
SMS_TEMPLATE=کد تایید تسویه‌گر: {code}

# نحوه استفاده:
# 1. این فایل را کپی کنید: cp sms-config.example .env
# 2. مقادیر واقعی را وارد کنید
# 3. Backend را دوباره اجرا کنید
