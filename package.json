{
  "name": "tasviegar",
  "version": "1.0.0",
  "description": "## 🟪 Product Overview",
  "main": "index.js",
  "scripts": {
    "start": "node -r ts-node/register -r tsconfig-paths/register backend/src/main.ts",
    "start:dev": "nodemon --watch backend/src --exec node -r ts-node/register -r tsconfig-paths/register backend/src/main.ts",
    "build": "tsc -p backend/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint backend/src --ext .ts",
    "lint:fix": "eslint backend/src --ext .ts --fix",
    "format": "prettier --write backend/src/**/*.ts",
    "migration:generate": "typeorm migration:generate -d backend/src/config/database.config.ts",
    "migration:run": "typeorm migration:run -d backend/src/config/database.config.ts",
    "migration:revert": "typeorm migration:revert -d backend/src/config/database.config.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:clean": "docker-compose down -v --remove-orphans"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.1",
    "@prisma/client": "^5.17.0",
    "argon2": "^0.31.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.10",
    "dotenv": "^17.2.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jalaliday": "^2.3.0",
    "moment-jalaali": "^0.10.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "sms-typescript": "^1.0.2",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.2.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "prisma": "^5.17.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
